{
  "name": "riskguard-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:all": "(cd ml-service && ./venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 8000) & npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:ml": "cd ml-service && ./venv/bin/python -m uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "postinstall": "npm --prefix frontend install"
  }
}
